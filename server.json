{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.happy520ai/gateway-price-check",
  "title": "Gateway Price Disclosure Check",
  "description": "Checks whether an OpenAI-compatible endpoint publishes model prices without an account or key.",
  "repository": {
    "url": "https://github.com/happy520ai/gateway-price-check",
    "source": "github"
  },
  "version": "0.5.8",
  "license": "MIT",
  "keywords": [
    "pricing-transparency",
    "openai-compatible",
    "ai-gateway",
    "read-only",
    "no-api-key"
  ],
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "__MCPB_URL__",
      "fileSha256": "__MCPB_SHA256__",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
